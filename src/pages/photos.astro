---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import { gallery } from '../data/photos';
import { links } from '../lib/site';
---

<Base title="Photos" description="Photos from the last few semesters of the Islamic Society of Ahlulbayt at the University of Michigan.">
  <section class="intro wrap" aria-labelledby="photos-title">
    <span class="eyebrow">Photos</span>
    <h1 id="photos-title" class="page-title">From the last few semesters</h1>
    <p class="lead">Tag <a href={links.instagram} target="_blank" rel="noopener">{links.instagram_handle}</a> to be featured.</p>
  </section>

  <ul class="grid wrap">
    {
      gallery.map((p, i) => (
        <li>
          <figure>
            <div class="media">
              <Photo photo={p} sizes="(min-width: 1200px) 368px, (min-width: 900px) 31vw, 50vw" priority={i === 0} />
            </div>
            {p.caption ? <figcaption>{p.caption}</figcaption> : <Placeholder class="caption">[Event · term {i + 1}]</Placeholder>}
          </figure>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    padding-top: 72px;
    padding-bottom: 40px;
  }

  .lead a {
    color: var(--ink-heading);
    text-decoration: underline;
    text-decoration-color: var(--maize);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 24px;
    margin-block: 0;
    padding-top: 48px;
    padding-bottom: 80px;
    list-style: none;
  }

  .media {
    height: 260px;
  }

  figcaption,
  .grid :global(.caption) {
    display: block;
    padding-top: 10px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  @media (max-width: 899.98px) {
    .intro {
      padding-top: 32px;
      padding-bottom: 20px;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 18px 12px;
      padding-top: 24px;
      padding-bottom: 32px;
    }

    .media {
      height: 150px;
    }

    figcaption,
    .grid :global(.caption) {
      padding-top: 6px;
      font-size: 11px;
    }
  }
</style>
