---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ThisWeek from '../components/ThisWeek.astro';
import DiamondDivider from '../components/DiamondDivider.astro';
import content from '../data/content.json';
import { photo } from '../data/photos';
import { getCalendar } from '../lib/calendar';
import { links, url } from '../lib/site';

const calendar = await getCalendar();
const row = ['IMG_4335', 'adc8466d', '4db790e4', 'IMG_2628', '3f3fdbc7'].map(photo);
---

<Base
  description="The Islamic Society of Ahlulbayt is the Shia Muslim student community at the University of Michigan. Dua, discussion, and dinner every week, open to Muslims and anyone interested in learning."
  footerLattice={false}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media media" aria-hidden="true">
      <Photo photo={photo('DSCF2344')} sizes="100vw" position="center 35%" priority />
    </div>
    <div class="hero-shade"></div>
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow">Shia Muslim student community · Ann Arbor</span>
        <h1 id="hero-title">A place to learn, connect, and serve.</h1>
        <p>Dua, discussion, and dinner every week. The Islamic Society of Ahlulbayt welcomes Muslims and anyone interested in learning.</p>
        <div class="hero-actions">
          <a class="btn btn--maize" href={links.members_chat} target="_blank" rel="noopener">Join the members chat</a>
          <a class="hero-link only-desktop" href={links.updates_chat} target="_blank" rel="noopener">Updates only</a>
        </div>
      </div>
      <div class="only-desktop">
        <ThisWeek calendar={calendar} variant="hero" />
      </div>
    </div>
  </section>

  <div class="only-mobile">
    <ThisWeek calendar={calendar} variant="compact" />
  </div>

  <section class="who wrap" aria-labelledby="who-title">
    <div>
      <h2 id="who-title" class="eyebrow who-eyebrow">Who we are</h2>
      <p class="mission">{content.org.mission}</p>
      <p class="who-line only-desktop">A student-run organization, a member of the Muslim Coalition at U-M, and firmly against Islamophobic and anti-Shi'i sentiment.</p>
      <a class="btn btn--outline" href={url('/about')}>About ISA</a>
    </div>
    <div class="who-photo media only-desktop">
      <Photo photo={photo('IMG_9246')} sizes="(min-width: 1200px) 507px, 42vw" />
    </div>
  </section>

  <div class="divider wrap"><DiamondDivider /></div>

  <section class="programs wrap" aria-labelledby="programs-title">
    <div class="section-head">
      <h2 id="programs-title" class="section-title">Regular programs</h2>
      <a class="see-all only-desktop" href={url('/programs')}>All programs</a>
    </div>
    <div class="program-grid">
      {
        content.programs.filter((p) => !('home' in p) || p.home !== false).map((p) => (
          <div class="program">
            <span class="eyebrow eyebrow--sm">{p.cadence}</span>
            <h3>{p.title}</h3>
            <p>{p.short}</p>
          </div>
        ))
      }
    </div>
    <a class="see-all only-mobile programs-more" href={url('/programs')}>All programs</a>
  </section>

  <div class="photo-row wrap">
    {
      row.map((p, i) => (
        <div class:list={['media', { 'only-desktop': i > 2 }]}>
          <Photo photo={p} sizes="(min-width: 900px) 224px, 33vw" />
        </div>
      ))
    }
  </div>

  <section class="support band lattice" aria-labelledby="support-title">
    <div class="support-inner wrap">
      <div>
        <span class="eyebrow">Support ISA</span>
        <h2 id="support-title" class="section-title">Your support keeps Thursday nights running.</h2>
        <p>ISA is funded through university grants that come event by event. Gifts from alumni and supporters go directly to weekly programming, guest speakers and dinners, educational materials, and Ramadan iftars.</p>
        <a class="btn btn--maize" href={url('/support')}>Ways to give</a>
      </div>
      <div class="support-photo media only-desktop">
        <Photo photo={photo('100_2894')} sizes="(min-width: 1200px) 528px, 45vw" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    background: var(--navy);
    color: #fff;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    background: var(--navy);
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 40, 72, 0.7) 0%, rgba(0, 40, 72, 0.2) 60%, rgba(0, 40, 72, 0) 100%),
      linear-gradient(180deg, rgba(0, 40, 72, 0.45) 0%, rgba(0, 40, 72, 0.25) 40%, rgba(0, 40, 72, 0.85) 100%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: end;
    min-height: 640px;
    padding-top: 150px;
    padding-bottom: 64px;
  }

  .hero-copy {
    padding-bottom: 16px;
  }

  .hero-eyebrow {
    margin-bottom: 20px;
    color: var(--maize);
  }

  .hero h1 {
    max-width: 600px;
    margin-bottom: 20px;
    font-family: var(--serif);
    font-size: 68px;
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero p {
    max-width: 480px;
    margin-bottom: 30px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-hero-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .hero-actions .btn {
    padding: 14px 26px;
  }

  .hero-link {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1.5px;
  }

  .hero-link:hover {
    color: var(--maize);
  }

  /* Who we are */
  .who {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    padding-top: 88px;
  }

  .who-eyebrow {
    margin-bottom: 16px;
  }

  .mission {
    margin-bottom: 18px;
    font-family: var(--serif);
    font-size: 32px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--ink-heading);
    text-wrap: pretty;
  }

  .who-line {
    max-width: 560px;
    margin-bottom: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-body);
  }

  .who .btn {
    padding: 13px 24px;
  }

  .who-photo {
    align-self: stretch;
    min-height: 380px;
  }

  .divider {
    padding-top: 72px;
  }

  /* Programs */
  .programs {
    padding-top: 64px;
    padding-bottom: 72px;
  }

  .programs .section-head {
    margin-bottom: 36px;
  }

  .program-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 48px;
  }

  .program h3 {
    margin: 8px 0 10px;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink-heading);
  }

  .program p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-body);
  }

  /* Photo row */
  .photo-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    padding-bottom: 80px;
  }

  .photo-row .media {
    height: 220px;
  }

  /* Support band */
  .support-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .support .eyebrow {
    margin-bottom: 16px;
  }

  .support h2 {
    margin-bottom: 16px;
  }

  .support p {
    max-width: 520px;
    margin-bottom: 26px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-navy-body);
  }

  .support .btn {
    padding: 14px 26px;
  }

  .support-photo {
    height: 360px;
  }

  @media (max-width: 899.98px) {
    .hero-inner {
      display: block;
      min-height: 0;
      padding-top: 190px;
      padding-bottom: 28px;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-shade {
      background: linear-gradient(180deg, rgba(0, 40, 72, 0.35) 0%, rgba(0, 40, 72, 0.5) 35%, rgba(0, 40, 72, 0.9) 100%);
    }

    .hero-eyebrow {
      margin-bottom: 12px;
    }

    .hero h1 {
      margin-bottom: 12px;
      font-size: 42px;
    }

    .hero p {
      margin-bottom: 18px;
      font-size: 15px;
      line-height: 1.5;
    }

    .hero-actions .btn {
      padding: 13px 20px;
    }

    .who {
      display: block;
      padding-top: 32px;
    }

    .who-eyebrow {
      margin-bottom: 10px;
    }

    .mission {
      margin-bottom: 12px;
      font-size: 22px;
    }

    .divider {
      padding-top: 32px;
    }

    .programs {
      padding-top: 28px;
      padding-bottom: 8px;
    }

    .programs .section-head {
      margin-bottom: 6px;
    }

    .program-grid {
      display: block;
    }

    .program {
      padding: 14px 0;
    }

    .program:nth-child(n + 4),
    .program p {
      display: none;
    }

    .program h3 {
      margin: 3px 0 0;
      font-size: 24px;
    }

    .programs-more {
      display: inline-block;
      margin-top: 14px;
    }

    .photo-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      padding: 24px 12px 32px;
    }

    .photo-row .media {
      height: 120px;
    }

    .support-inner {
      display: block;
      padding-top: 36px;
      padding-bottom: 36px;
    }

    .support .eyebrow {
      margin-bottom: 10px;
    }

    .support h2 {
      margin-bottom: 10px;
      font-size: 32px;
    }

    .support p {
      margin-bottom: 16px;
      font-size: 15px;
      line-height: 1.55;
    }

    .support .btn {
      padding: 12px 20px;
      font-size: 14px;
    }
  }
</style>
